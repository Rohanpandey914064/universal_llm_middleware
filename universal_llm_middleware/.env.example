# ─────────────────────────────────────────────────────────────────────────────
# universal_llm_middleware — .env.example
#
# Copy this file to `.env` and fill in your values.
# Never commit your real `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstream LLM Provider ─────────────────────────────────────────────────────
UPSTREAM_LLM_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
DEFAULT_MODEL=gpt-4o-mini

# ── FastAPI Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
WORKERS=1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security Engine ───────────────────────────────────────────────────────────
# Threat score threshold — inputs scoring ≥ this value are blocked.
INJECTION_THRESHOLD=0.58

# Optional: path to a local ONNX DeBERTa model for enhanced detection.
# Leave blank to use heuristic-only mode.
# ONNX_MODEL_PATH=/path/to/deberta-injection-detector.onnx

# spaCy model name for NER-based PII detection.
# Run `python -m spacy download en_core_web_sm` to install.
SPACY_MODEL=en_core_web_sm

# Canary token format. Must contain {token}.
CANARY_PATTERN=[[CANARY-{token}]]

# ── History Engine ────────────────────────────────────────────────────────────
# Session TTL in seconds (default: 1 hour)
SESSION_TTL_SECONDS=3600

# Maximum conversational turns stored per session
MAX_HISTORY_TURNS=50

# ── Compression Engine ────────────────────────────────────────────────────────
# Token budget for compressed history (approx. GPT tokenisation)
MAX_HISTORY_TOKENS=3000

# Minimum cosine similarity between original and compressed text.
# Values below this threshold trigger a warning.
DRIFT_THRESHOLD=0.90

# ── HTTP Timeouts ─────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=60.0
