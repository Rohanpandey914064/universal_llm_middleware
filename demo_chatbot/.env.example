# ─────────────────────────────────────────────────────────────────────────────
# demo_chatbot — .env.example
# Safe sample configuration for public GitHub use.
# Copy this to `.env` locally and keep your actual credentials private.
# ─────────────────────────────────────────────────────────────────────────────

# Middleware Base URL (Universal LLM Middleware)
MIDDLEWARE_BASE_URL=http://localhost:8080/v1

# Direct Upstream URL (For testing Direct/Unprotected mode)
DIRECT_GROQ_URL=https://api.groq.com/openai/v1

# Groq API Key (Used when in Direct Mode)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Default Model Name
DEFAULT_MODEL=llama-3.3-70b-versatile
